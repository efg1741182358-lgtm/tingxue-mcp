# 连接器访问口令：claude.ai 挂载时的授权页要输它。自己设一个长一点的。
AUTH_PASSWORD=change-me-to-something-long

# 对外地址，OAuth 回调要用。部署后填 Zeabur 给的域名。
PUBLIC_URL=https://your-app.zeabur.app

# 网易云按 IP 限区。服务器在境外时必须带一个国内 IP，否则静默返回空结果或 -460。
# 不设置 = 不注入任何出口 IP（本机就在国内时正是要这样）。
# 服务不会替你挑一个地址顶上——那会让所有忘了配的部署共用同一个 IP。
# REAL_IP=你的国内IP

# 登录态存放目录，Docker 里已设为 /app/data
DATA_DIR=./data

# 只启用需要的工具组，省 token（不设=全开，约 1300 token/轮的固定开销）
# 可用组：search / lyric / library / social / together / status
# TOOLS=search,lyric
